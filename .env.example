# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Bolna AI Integration
# Configure BOLNA_API_KEY and BOLNA_AGENT_ID to enable remote Bolna Web Call Agent.
# When omitted, VoiceBridge AI gracefully operates with native high-fidelity Web Speech API.
BOLNA_API_KEY=""
BOLNA_AGENT_ID=""

# Optional: Supabase Integration
# Configure SUPABASE_URL and SUPABASE_ANON_KEY for remote cloud state persistence.
# When omitted, VoiceBridge AI persists conversations and workflows locally with full functionality.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
